# GEMINI_API_KEY: Enables AI-generated architecture insights in /api/estimator.
# Optional — the estimator falls back to a built-in deterministic engine without it.
# Local: copy this file to .env.local and fill in. Vercel: Project → Settings → Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical site URL, used for metadata / OG tags.
# Local: http://localhost:3000 — Vercel: auto-detected via VERCEL_URL, only set this
# if you have a custom domain (e.g. https://vintoria.studio).
APP_URL="MY_APP_URL"
