# GEMINI_API_KEY: Enables AI-generated architecture insights in /api/estimator.
# Optional — the estimator falls back to a built-in deterministic engine without it.
# Local: copy this file to .env.local and fill in. Vercel: Project → Settings → Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical site URL, used for metadata / OG tags / sitemap.
# Local: http://localhost:3000 — Vercel: auto-detected via VERCEL_URL, only set this
# if you have a custom domain (e.g. https://vintoria.studio).
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Enables real email delivery of project briefs from /api/inquiry.
# Get a free key at resend.com. Without it, briefs still succeed and the UI shows
# a pre-filled WhatsApp fast-track link instead.
RESEND_API_KEY="MY_RESEND_API_KEY"

# INQUIRY_TO_EMAIL: Where project briefs are delivered. Default: studio@vintoria.engineering
INQUIRY_TO_EMAIL="studio@vintoria.engineering"

# INQUIRY_FROM_EMAIL: The verified sender Resend sends briefs from (verify it in Resend
# domains first). Until you verify vintoria.engineering, the resend.dev test address works.
INQUIRY_FROM_EMAIL="Vintoria Website <onboarding@resend.dev>"
